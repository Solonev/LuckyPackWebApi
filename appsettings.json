{
  "TelegramOptions": {
    "BotToken": "",
    "WebAppUrl": "https://sporting-deranged-retaining.ngrok-free.dev/?debug=true"
    //"WebAppUrl": "https://mclucky-test.vercel.app/"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "EmailOptions": {
    "SmtpServer": "",
    "SmtpPort": 465,
    "Email": "",
    "Password": "",
    "EnableSsl": true
  }
}
